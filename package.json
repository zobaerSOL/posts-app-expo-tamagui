{
  "name": "posts-app-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-navigation/native": "^7.5.1",
    "@tamagui/config": "^3.2.3",
    "@tamagui/font-inter": "^3.2.3",
    "@tamagui/helpers-icon": "^3.2.3",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-server": "~58.0.6",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "tamagui": "^3.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.65.0",
    "@tamagui/cli": "^3.2.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "css": "tamagui generate-css",
    "start": "npm run css && expo start",
    "web": "npm run css && expo start --web",
    "ios": "npm run css && expo start --ios",
    "android": "npm run css && expo start --android",
    "build:web": "npm run css && expo export --platform web",
    "serve:web": "expo serve",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "private": true
}
