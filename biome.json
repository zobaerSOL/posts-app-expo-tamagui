{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      ".expo",
      "ios",
      "android",
      "tamagui.generated.css",
      "expo-env.d.ts",
      ".tamagui",
      "components/icons",
      "docs/lighthouse",
      "test-results",
      "playwright-report"
    ]
  },
  "organizeImports": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noConsoleLog": "error", "noExplicitAny": "error" },
      "style": { "useImportType": "error", "noNonNullAssertion": "off", "useTemplate": "off" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "attributePosition": "multiline"
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "es5",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "include": ["components/hr/**", "components/shell/**", "features/home/**"],
      "linter": { "rules": { "a11y": { "useSemanticElements": "off" } } }
    }
  ]
}
